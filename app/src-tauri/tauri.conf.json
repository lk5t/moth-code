{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOTH Code",
  "version": "0.6.0",
  "identifier": "dev.mothcode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MOTH Code",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#080808",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* https:; img-src 'self' data: blob: https: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MOTH Code",
    "category": "DeveloperTool",
    "shortDescription": "Independent AI coding agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {},
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh",
        "startMenuFolder": "MOTH Code",
        "compression": "lzma"
      }
    },
    "copyright": "\u00a9 2026 MOTH Code \u00b7 Independent AI coding agent",
    "longDescription": "MOTH Code is an independent AI coding agent powered by its own neural network, trained from scratch."
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://moth-cloud.invalid/v1/updates/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
