# MOTH Server configuration. Copy to moth-server.env (git-ignored) and fill in.
# Secrets may also be given as *_FILE paths (e.g. MOTH_SMTP_PASSWORD_FILE=/run/secrets/smtp).

MOTH_SERVER_PUBLIC_URL=https://moth.example.com
MOTH_SERVER_DATABASE_URL=postgresql+psycopg://moth:CHANGE_ME@postgres:5432/moth

# Email (verification + password recovery). Without SMTP, emails go to /data/outbox (development only).
MOTH_SMTP_HOST=smtp.example.com
MOTH_SMTP_PORT=587
MOTH_SMTP_USER=
MOTH_SMTP_PASSWORD=
MOTH_SMTP_FROM=MOTH Code <no-reply@moth.example.com>

# Payments (Stripe). Leave empty to keep paid checkout disabled.
MOTH_STRIPE_SECRET_KEY=
MOTH_STRIPE_WEBHOOK_SECRET=

# MOTH Cloud inference runs the deployed official release. Optional explicit device: cuda | cpu | auto
MOTH_SERVER_INFERENCE_DEVICE=auto

# Extra desktop/web origins allowed by CORS (comma-separated), if any.
MOTH_SERVER_CORS_ORIGINS=
